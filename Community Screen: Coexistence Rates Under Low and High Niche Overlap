function dydt=crm_ode(,y,p)
N=max(y(1:2),0); R=max(y(3:4),0);
dN=zeros(2,1);
for i=1:2
dN(i)=N(i)(sum((1-p.l).*p.C(i,:)'.*p.W.*R)-p.m(i));
end
dR=zeros(2,1);
for a=1:2
dep=R(a)*sum(p.C(:,a).N); rec=0;
for b=1:2
rec=rec+p.l(b)(p.W(b)/p.W(a))*p.C(a,b)*R(b)*sum(p.C(:,b).*N);
end
dR(a)=p.S(a)-dep+rec;
end
dydt=[dN;dR]; dydt(~isfinite(dydt))=0;
end
function J=crm_jacobian(N,R,p)
J=zeros(4,4);
for i=1:2
J(i,i)=sum((1-p.l).*p.C(i,:)'.*p.W.R)-p.m(i);
for a=1:2, J(i,2+a)=N(i)(1-p.l(a))*p.C(i,a)p.W(a); end
end
for a=1:2
for i=1:2
rec=0;
for b=1:2, rec=rec+p.l(b)(p.W(b)/p.W(a))*p.C(a,b)*R(b)*p.C(i,b); end
J(2+a,i)=-p.C(i,a)*R(a)+rec;
end
for b=1:2
if a==b
J(2+a,2+b)=(p.l(a)*p.C(a,a)-1)*sum(p.C(:,a).*N);
else
J(2+a,2+b)=p.l(b)p.C(a,b)(p.W(b)/p.W(a))sum(p.C(:,b).N);
end
end
end
end
function boxplot_manual(data, x, col)
q = quantile(data,[0.25 0.5 0.75]);
iqr_val = q(3)-q(1);
wlo = max(min(data), q(1)-1.5iqr_val);
whi = min(max(data), q(3)+1.5iqr_val);
w=0.3;
fill([x-w x+w x+w x-w x-w],[q(1) q(1) q(3) q(3) q(1)],col,'FaceAlpha',0.3,'EdgeColor',col,'LineWidth',1);
line([x-w x+w],[q(2) q(2)],'Color',col,'LineWidth',2);
line([x x],[wlo q(1)],'Color',col,'LineWidth',1);
line([x x],[q(3) whi],'Color',col,'LineWidth',1);
end
